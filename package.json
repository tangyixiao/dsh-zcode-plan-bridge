{
  "name": "dsh-zcode-plan-bridge",
  "version": "0.5.1-startplan.1",
  "description": "Exposes the ZCode CLI's bundled agent as a DeepSeek Harness model provider: streaming, image input, per-session reuse, and a model list read from the CLI instead of hard-coded. Derived from kyle123740/dsh-zcode-cli-proxy.",
  "license": "AGPL-3.0",
  "author": "kyle123740",
  "contributors": [
    "tangyixiao"
  ],
  "homepage": "https://github.com/tangyixiao/dsh-zcode-plan-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyixiao/dsh-zcode-plan-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/tangyixiao/dsh-zcode-plan-bridge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "zcode",
    "glm",
    "zai",
    "model-provider"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-zcode-plan-bridge": "bin/dsh-zcode-plan-bridge.js"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "diagnose": "node bin/dsh-zcode-plan-bridge.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5 <0.3.0-0 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0 || 4.0.1-rc.1 || 4.0.1-rc.4 || 4.0.5-alpha.1 || 4.0.5-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0 || 3.18.1-rc.1 || 3.18.1-rc.4 || 3.18.5-alpha.1 || 3.18.5-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.3.0-0 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
